# ============================================
#  YPDC UON — server settings (.env)
#  Is file ko copy kar ke ".env" bana lein aur values badal dein:
#      cp .env.example .env
# ============================================

# server
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# database file (SQLite)
DB_FILE=./data/ypdc.sqlite

# ---- SECURITY (production se pehle zaroor badlein) ----
# 1) tokens ki secret key — lamba random text:
#    node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# 2) admin ka doosra qadam — admin login mein ye key bhi maangi jati hai
ADMIN_KEY=change-this-admin-key

# 3) login session kitne ghante chale
TOKEN_HOURS=8

# 4) naye demo accounts ka password (npm run seed)
# admin panel ka password (pehli dafa first-run khud bana kar yahan likh deta hai)
ADMIN_PASSWORD=

# 5) sirf in domains se API calls aayein (khaali = same-origin only)
# Sirf EXTRA domains likhein (site ka apna origin khud-ba-khud allowed hai).
# Khaali chhod dein to sirf apna origin chalta hai. Misal: https://ypdc.uon.edu.pk,http://192.168.1.5:8000
ALLOWED_ORIGINS=
# Kis domain ke iframe mein site khul sakti hai (clickjacking protection).
# Default: apna origin + Arena preview hosts. Zyada chahiye to yahan space se likhein.
FRAME_ANCESTORS='self' https://*.e2b.app https://*.arena.ai

# 6) uploaded pictures (admin panel) kahan rakhi jayein
# Khaali = website ke andar: frontend/assets/uploads  (short URL: assets/uploads/...)
# Apne server/disks par: UPLOAD_DIR=/var/data/uploads  (URL: /uploads/...)
UPLOAD_DIR=

# 7) Email (SMTP) — credentials sirf yahan, code mein kabhi nahi
#    Khaali chhod dein to koi email bahar nahi jati; har email "Email Outbox"
#    (admin panel) aur email_logs table mein save hoti rehti hai — local testing ke liye.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=YPDC UON <no-reply@ypdc-uon.local>

# 8) Site ka apna pura address (email ke links isi se bante hain)
SITE_URL=http://localhost:8000

# 9) Password reset link kitne minute chale (single-use, default 30)
RESET_MINUTES=30

# 10) Sirf local testing: 1 karne par forgot-password ka link jawab mein bhi
#     aata hai (SMTP set ho to ye khud band rehta hai). Production mein 0 rakhein.
MAIL_DEV_PREVIEW=1
