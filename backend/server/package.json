{
  "name": "ypdc-uon-server",
  "version": "1.0.0",
  "private": true,
  "description": "YPDC UON — backend API (Express + SQLite + JWT + bcrypt). Frontend isi server se serve hota hai.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed-real.js",
    "seed:content": "node scripts/seed-content.js",
    "export:content": "node scripts/export-content.js",
    "first-run": "node scripts/first-run.js",
    "make-admin": "node scripts/make-admin.js",
    "test": "node scripts/api-test.js",
    "setup": "node scripts/first-run.js && node server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2"
  }
}
